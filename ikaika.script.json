{
    "version": "0.0.0+1",
    "name": "react-native-script",
    "description": "A React Native Script project",
    "title": "React Native Script",
    "rules": {
        "global": ["flag", "type", "required", "description"],
        "string": ["allowed_regex"],
        "array": ["allowed_values"],
        "object": ["required_keys"],
        "number": ["min", "max"],
        "boolean": []
    },
    "config": {

        "scaffold": {

            "screen": {
                "args": [
                    {
                        "flag": "name",
                        "type": "string",
                        "required": true,
                        "allowed_regex": "^[a-z]+(-[a-z]+)*$",
                        "description": "The screen name; kebab-case is recommended"
                    },
                    { "flag": "overwrite", "type": "boolean", "required": false, "description": "Replace the screen and its companion files when they already exist" },
                    { "flag": "skip-companions", "type": "boolean", "required": false, "description": "Create only the screen, without its controller, constant, and enum" }
                ],
                "path": "${root}/src/screens",
                "template": "templates/screen.template.tsx",
                "filename": "${screen.args.name}.screen.tsx",

                "message-success": "Screen created and normalized successfully",
                "message-error": "Error creating screen: ${error}",
                "message-exists": "Screen already exists at ${screen.path}/${screen.filename}",
                "message-invalid-args": "Provide a lowercase screen name, preferably kebab-case (e.g., 'user-profile')",
                "message-invalid-path": "Invalid path provided for screen creation",
                "message-invalid-template": "Invalid template provided for screen creation",
                "command-after-success": [
                    "node \"scripts/finalize-scaffold-template.mjs\" --kind \"screen\" --target \"${screen.path}/${screen.filename}\" --name \"${screen.args.name}\" --project-root \"${root}\" --overwrite \"${screen.args.overwrite}\" --skip-companions \"${screen.args.skip-companions}\""
                ]
            },

            "layout": {
                "args": [
                    { "flag": "name", "type": "string", "required": true, "allowed_regex": "^[a-z]+(-[a-z]+)*$", "description": "The layout name; kebab-case is recommended" },
                    { "flag": "overwrite", "type": "boolean", "required": false, "description": "Replace the layout and its companion files when they already exist" },
                    { "flag": "skip-companions", "type": "boolean", "required": false, "description": "Create only the layout, without its controller, constant, and enum" }
                ],
                "path": "${root}/src/layouts",
                "template": "templates/layout.template.tsx",
                "filename": "${layout.args.name}.layout.tsx",
                "message-success": "Layout and companion files created successfully",
                "message-error": "Error creating layout: ${error}",
                "message-exists": "Layout already exists at ${layout.path}/${layout.filename}",
                "message-invalid-args": "Provide a lowercase layout name, preferably kebab-case",
                "message-invalid-path": "Invalid layout path",
                "message-invalid-template": "Invalid layout template",
                "command-after-success": [
                    "node \"scripts/finalize-scaffold-template.mjs\" --kind \"layout\" --target \"${layout.path}/${layout.filename}\" --name \"${layout.args.name}\" --project-root \"${root}\" --overwrite \"${layout.args.overwrite}\" --skip-companions \"${layout.args.skip-companions}\""
                ]
            },

            "widget": {
                "args": [
                    { "flag": "name", "type": "string", "required": true, "allowed_regex": "^[a-z]+(-[a-z]+)*$" }
                ],
                "path": "${root}/src/components/widgets",
                "template": "templates/widget.template.tsx",
                "filename": "${widget.args.name}.widget.tsx",
                "message-success": "Widget created successfully",
                "message-error": "Error creating widget: ${error}",
                "message-exists": "Widget already exists at ${widget.path}/${widget.filename}",
                "message-invalid-args": "Provide a lowercase widget name, preferably kebab-case",
                "message-invalid-path": "Invalid widget path",
                "message-invalid-template": "Invalid widget template",
                "command-after-success": [
                    "node \"scripts/finalize-scaffold-template.mjs\" --kind \"widget\" --target \"${widget.path}/${widget.filename}\" --name \"${widget.args.name}\" --project-root \"${root}\""
                ]
            },

            "apiEndpoint": {
                "args": [
                    { "flag": "name", "type": "string", "required": true, "allowed_regex": "^[a-z]+(-[a-z]+)*$", "description": "The API resource name; kebab-case is recommended" },
                    { "flag": "overwrite", "type": "boolean", "required": false, "description": "Replace the endpoint when one of the same name already exists" }
                ],
                "path": "${root}/src/apis/endpoint",
                "template": "templates/api-endpoint.template.ts",
                "filename": "ping.${apiEndpoint.args.name}.api.ts",
                "message-success": "GET ping endpoint created successfully",
                "message-error": "Error creating API endpoint: ${error}",
                "message-exists": "API endpoint staging file already exists",
                "message-invalid-args": "Provide a lowercase API resource name, preferably kebab-case",
                "message-invalid-path": "Invalid API endpoint path",
                "message-invalid-template": "Invalid API endpoint template",
                "command-after-success": [
                    "node \"scripts/finalize-scaffold-template.mjs\" --kind \"apiEndpoint\" --target \"${apiEndpoint.path}/${apiEndpoint.filename}\" --name \"${apiEndpoint.args.name}\" --project-root \"${root}\" --overwrite \"${apiEndpoint.args.overwrite}\""
                ]
            },

            "apiModel": {
                "args": [
                    { "flag": "name", "type": "string", "required": true, "allowed_regex": "^[a-z]+(-[a-z]+)*$", "description": "The API resource name; kebab-case is recommended" },
                    { "flag": "overwrite", "type": "boolean", "required": false, "description": "Replace the model and its GET ping endpoint when they already exist" },
                    { "flag": "skip-companions", "type": "boolean", "required": false, "description": "Create only the model, without the GET ping endpoint" }
                ],
                "path": "${root}/src/apis/models",
                "template": "templates/api-model.template.ts",
                "filename": "${apiModel.args.name}.model.ts",
                "message-success": "API model and GET ping endpoint created successfully",
                "message-error": "Error creating API model: ${error}",
                "message-exists": "API model already exists at ${apiModel.path}/${apiModel.filename}",
                "message-invalid-args": "Provide a lowercase API resource name, preferably kebab-case",
                "message-invalid-path": "Invalid API model path",
                "message-invalid-template": "Invalid API model template",
                "command-after-success": [
                    "node \"scripts/finalize-scaffold-template.mjs\" --kind \"apiModel\" --target \"${apiModel.path}/${apiModel.filename}\" --name \"${apiModel.args.name}\" --project-root \"${root}\" --overwrite \"${apiModel.args.overwrite}\" --skip-companions \"${apiModel.args.skip-companions}\""
                ]
            },

            "service": {
                "args": [
                    { "flag": "name", "type": "string", "required": true, "allowed_regex": "^[a-z]+(-[a-z]+)*$" }
                ],
                "path": "${root}/src/core/services",
                "template": "templates/service.template.ts",
                "filename": "${service.args.name}.service.ts",
                "message-success": "Service created successfully",
                "message-error": "Error creating service: ${error}",
                "message-exists": "Service already exists at ${service.path}/${service.filename}",
                "message-invalid-args": "Provide a lowercase service name, preferably kebab-case",
                "message-invalid-path": "Invalid service path",
                "message-invalid-template": "Invalid service template",
                "command-after-success": [
                    "node \"scripts/finalize-scaffold-template.mjs\" --kind \"service\" --target \"${service.path}/${service.filename}\" --name \"${service.args.name}\" --project-root \"${root}\""
                ]
            },

            "storage": {
                "args": [
                    { "flag": "name", "type": "string", "required": true, "allowed_regex": "^[a-z]+(-[a-z]+)*$" }
                ],
                "path": "${root}/src/core/storages",
                "template": "templates/storage.template.ts",
                "filename": "${storage.args.name}.storage.ts",
                "message-success": "Storage created successfully",
                "message-error": "Error creating storage: ${error}",
                "message-exists": "Storage already exists at ${storage.path}/${storage.filename}",
                "message-invalid-args": "Provide a lowercase storage name, preferably kebab-case",
                "message-invalid-path": "Invalid storage path",
                "message-invalid-template": "Invalid storage template",
                "command-after-success": [
                    "node \"scripts/finalize-scaffold-template.mjs\" --kind \"storage\" --target \"${storage.path}/${storage.filename}\" --name \"${storage.args.name}\" --project-root \"${root}\""
                ]
            },

            "utility": {
                "args": [
                    { "flag": "name", "type": "string", "required": true, "allowed_regex": "^[a-z]+(-[a-z]+)*$" }
                ],
                "path": "${root}/src/core/utilities",
                "template": "templates/utility.template.ts",
                "filename": "${utility.args.name}.utility.ts",
                "message-success": "Utility created successfully",
                "message-error": "Error creating utility: ${error}",
                "message-exists": "Utility already exists at ${utility.path}/${utility.filename}",
                "message-invalid-args": "Provide a lowercase utility name, preferably kebab-case",
                "message-invalid-path": "Invalid utility path",
                "message-invalid-template": "Invalid utility template",
                "command-after-success": [
                    "node \"scripts/finalize-scaffold-template.mjs\" --kind \"utility\" --target \"${utility.path}/${utility.filename}\" --name \"${utility.args.name}\" --project-root \"${root}\""
                ]
            },

            "state": {
                "args": [
                    { "flag": "name", "type": "string", "required": true, "allowed_regex": "^[a-z]+(-[a-z]+)*$" }
                ],
                "path": "${root}/src/core/states",
                "template": "templates/state.template.ts",
                "filename": "${state.args.name}.state.ts",
                "message-success": "State created successfully",
                "message-error": "Error creating state: ${error}",
                "message-exists": "State already exists at ${state.path}/${state.filename}",
                "message-invalid-args": "Provide a lowercase state name, preferably kebab-case",
                "message-invalid-path": "Invalid state path",
                "message-invalid-template": "Invalid state template",
                "command-after-success": [
                    "node \"scripts/finalize-scaffold-template.mjs\" --kind \"state\" --target \"${state.path}/${state.filename}\" --name \"${state.args.name}\" --project-root \"${root}\""
                ]
            },

            "manager": {
                "args": [
                    { "flag": "name", "type": "string", "required": true, "allowed_regex": "^[a-z]+(-[a-z]+)*$" }
                ],
                "path": "${root}/src/core/managers",
                "template": "templates/manager.template.ts",
                "filename": "${manager.args.name}.manager.ts",
                "message-success": "Manager created successfully",
                "message-error": "Error creating manager: ${error}",
                "message-exists": "Manager already exists at ${manager.path}/${manager.filename}",
                "message-invalid-args": "Provide a lowercase manager name, preferably kebab-case",
                "message-invalid-path": "Invalid manager path",
                "message-invalid-template": "Invalid manager template",
                "command-after-success": [
                    "node \"scripts/finalize-scaffold-template.mjs\" --kind \"manager\" --target \"${manager.path}/${manager.filename}\" --name \"${manager.args.name}\" --project-root \"${root}\""
                ]
            },

            "constant": {
                "args": [
                    { "flag": "name", "type": "string", "required": true, "allowed_regex": "^[a-z]+(-[a-z]+)*$" }
                ],
                "path": "${root}/src/core/constants",
                "template": "templates/constant.template.ts",
                "filename": "${constant.args.name}.constant.ts",
                "message-success": "Constant created successfully",
                "message-error": "Error creating constant: ${error}",
                "message-exists": "Constant already exists at ${constant.path}/${constant.filename}",
                "message-invalid-args": "Provide a lowercase constant name, preferably kebab-case",
                "message-invalid-path": "Invalid constant path",
                "message-invalid-template": "Invalid constant template",
                "command-after-success": [
                    "node \"scripts/finalize-scaffold-template.mjs\" --kind \"constant\" --target \"${constant.path}/${constant.filename}\" --name \"${constant.args.name}\" --project-root \"${root}\""
                ]
            },

            "enum": {
                "args": [
                    { "flag": "name", "type": "string", "required": true, "allowed_regex": "^[a-z]+(-[a-z]+)*$" }
                ],
                "path": "${root}/src/core/enums",
                "template": "templates/enum.template.ts",
                "filename": "${enum.args.name}.enum.ts",
                "message-success": "Enum created successfully",
                "message-error": "Error creating enum: ${error}",
                "message-exists": "Enum already exists at ${enum.path}/${enum.filename}",
                "message-invalid-args": "Provide a lowercase enum name, preferably kebab-case",
                "message-invalid-path": "Invalid enum path",
                "message-invalid-template": "Invalid enum template",
                "command-after-success": [
                    "node \"scripts/finalize-scaffold-template.mjs\" --kind \"enum\" --target \"${enum.path}/${enum.filename}\" --name \"${enum.args.name}\" --project-root \"${root}\""
                ]
            }

        }
    }
}
